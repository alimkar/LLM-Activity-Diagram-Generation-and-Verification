@startuml
|User|
start
:Open HATS-GUI session;
:Select or create application;

|HATS-GUI|
if (Manage application files?) then (yes)
  |User|
  :Choose file operation (create/modify/delete);
  |HATS-GUI|
  :Create/modify/delete application-related files\n(in application directory);
  :Manage file associations within application;
  |User|
  :Examine/modify file associations;
endif

|User|
:Select operation;

|HATS-GUI|
if (Parse files?) then (yes)
  |User|
  :Select transformation language program file;
  :Select target program file;
  |HATS-GUI|
  fork
    :Orchestrate parsing of transformation language program\n(text -> SDT);
  fork again
    :Orchestrate parsing of target program\n(text -> SDT);
  end fork

  :Invoke parser program (generated by HATS-SML);
  :Provide lexical specification and grammar\nfor parser generation;

  if (Save parsed versions to expedite execution?) then (yes)
    :Save parsed SDT(s) as files;
    :Associate saved files with application;
  endif

  if (Parsing produced errors?) then (yes)
    :Capture error output from HATS-SML;
    |User|
    :View parsing error messages;
  endif

elseif (Execute transformation program?) then (yes)
  |User|
  :Select transformation language program to execute;
  |HATS-GUI|
  if (Transformation program parsed and saved as SDT?) then (yes)
    :Orchestrate execution via HATS-SML;
    :Use target program identified in transformation program\n(input file names embedded);
    :Capture debugging output stream (if specified);
    :Capture error output stream (if specified);
    :Receive output SDT(s) from HATS-SML;
    :Associate output SDT files with application;
    if (Pretty-print requested?) then (yes)
      :Apply pretty-print service using pretty-print style file;
      :Produce pretty-printed text output;
      :Associate pretty-printed output files with application;
    endif
    |User|
    :View debugging/error outputs (if any);
  else (no)
    :Notify user execution requires parsed+saved SDT;
  endif

elseif (Examine outputs?) then (yes)
  |HATS-GUI|
  :List application-associated data sets/files\n(created/saved/used/deleted during session);
  |User|
  :Select file/data set for display;
  |HATS-GUI|
  if (Display SDT?) then (yes)
    :Display SDT;
    |User|
    :Choose portions of tree to display;
    :Search for text strings and sub-trees;
  else (no)
    :Display pretty-printed text output;
    |User|
    :Search for text strings;
  endif
  |HATS-GUI|
  :Display transformation/parsing error messages\n(if present);
endif

stop
@enduml