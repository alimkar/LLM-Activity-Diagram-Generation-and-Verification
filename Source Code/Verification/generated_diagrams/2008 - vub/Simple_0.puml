@startuml
|User|
start
if (Connected to VUB-network?) then (yes)
  if (Logged in?) then (yes)
    if (User level?) then (Member)
      repeat
        if (Select function?) then (Change account details)
          :Change account details;
          if (Request account upgrade?) then (yes)
            :Send upgrade request;
          else (no)
          endif
        elseif (Select function?) then (Search)
          :Enter keywords;
          :Enter authors;
          :Enter date range;
          :Submit search query;
          if (Valid search query?) then (yes)
            :View results;
            repeat
              if (Select result function?) then (Order results)
                :Order results;
              elseif (Select result function?) then (Export and download results)
                :Select results;
                :Select export format (html/pdf/ps);
                :Export and download results;
              elseif (Select result function?) then (Search on similarity)
                :Search similar publications;
              else (Back)
              endif
            repeat while (More result actions?) is (yes)
          else (no)
          endif
        elseif (Select function?) then (Advanced search)
          :Enter additional keywords;
          :Specify referring publications;
          :Submit advanced search query;
          if (Valid search query?) then (yes)
            :View results;
            repeat
              if (Select result function?) then (Order results)
                :Order results;
              elseif (Select result function?) then (Export and download results)
                :Select results;
                :Select export format (html/pdf/ps);
                :Export and download results;
              elseif (Select result function?) then (Search on similarity)
                :Search similar publications;
              else (Back)
              endif
            repeat while (More result actions?) is (yes)
          else (no)
          endif
        elseif (Select function?) then (Log off)
          :Log off;
          :Redirect to search page;
        else (Exit)
        endif
      repeat while (Perform another function?) is (yes)
