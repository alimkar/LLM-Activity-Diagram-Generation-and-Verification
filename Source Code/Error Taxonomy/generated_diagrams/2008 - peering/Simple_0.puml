:Deploy functional policies;
:Administer peering arrangement;

fork
:Redirect portion of web traffic;
fork again
:Control content replication;
fork again
:Exchange accounting information;
end fork

while (Changing circumstances?) is (yes)
if (Need disband or re-arrange?) then (yes)
if (Circumstances no longer hold?) then (yes)
:Disband arrangement;
else (no)
if (Peering no longer beneficial?) then (yes)
:Disband arrangement;
else (no)
if (Need expand for additional load?) then (yes)
:Re-arrange arrangement;
else (no)
if (Contributions not met?) then (yes)
:Re-arrange arrangement;
else (no)
endif
endif
endif
endif
endif
endif
endwhile (no)

stop
else (no)
:Reconsider service requirements;
:Tune negotiated relationships;
:Resume peering creation;
stop
endif

else (no)
:Serve requests locally;
stop
